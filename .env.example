
# ---------------------------------------------------------------- Payments API
APP_ENV=local                      # [local]
APP_BASE_URL=http://localhost:8001
DATABASE_URL=sqlite:///./payments.db
CASHFREE_MODE=sandbox              # sandbox | replay — never falls back on its own
CASHFREE_BASE_URL=https://sandbox.cashfree.com/pg
CASHFREE_CLIENT_ID=
CASHFREE_CLIENT_SECRET=
CASHFREE_API_VERSION=2023-08-01    # [2023-08-01]

# Operator token for the fault trigger. Generate 32+ random characters.
CHAOS_TOKEN=

# ---------------------------------------------------------------- Observability
PROMETHEUS_URL=http://localhost:9091
ALERTMANAGER_URL=http://localhost:9093
ALERT_RELAY_PORT=8085              # [8085]
ALERT_RELAY_URL=http://localhost:8085
RUNBOOK_URL=https://github.com/Abdeali1310/sentinel-sre/blob/main/sre-agent/docs/runbook.md

# ---------------------------------------------------------------- Mattermost
# Incoming webhook bound to #incidents:
#   Integrations → Incoming Webhooks → Add → channel #incidents
MATTERMOST_WEBHOOK_URL=
MATTERMOST_CHANNEL=#incidents      # [#incidents]
# Comma-separated Mattermost usernames allowed to command write actions (advisory).
MATTERMOST_ALLOWED_USERS=
BOT_DISPLAY_NAME=Sentinel          # [Sentinel]

# ---------------------------------------------------------------- Jira
# JIRA_URL is the bare site root, no trailing slash.
JIRA_URL=https://your-site.atlassian.net
JIRA_EMAIL=<your-jira-email>
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=KAN
JIRA_ISSUE_TYPE=Task               # [Task] — the project ships Epic/Subtask/Task/Story, no Bug
JIRA_LABELS=incident,sre-agent     # [incident,sre-agent]
JIRA_TRANSITION_IN_PROGRESS=In Progress
JIRA_TRANSITION_DONE=Done

# ---------------------------------------------------------------- GitHub
# Fine-grained PAT scoped to this one repository:
# Contents read/write, Pull requests read/write, Actions read, Metadata read.
# No workflow scope, no administration.
GITHUB_TOKEN=
# GITHUB_REPO accepts either "sentinel-sre" or "owner/sentinel-sre".
GITHUB_REPO=sentinel-sre
GITHUB_OWNER=Abdeali1310
GITHUB_BASE_BRANCH=main            # [main]

# ---------------------------------------------------------------- Agent limits
MAX_TOOL_CALLS=15                  # [15]
MAX_WALL_CLOCK_SECONDS=600         # [600]
MAX_TURNS=25                       # [25]
SMOKE_PAYMENT_COUNT=10             # [10]
SMOKE_PAYMENT_INTERVAL_SECONDS=3   # [3]
ERROR_RATIO_THRESHOLD=0.01         # [0.01]
